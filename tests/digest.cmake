execute_process(COMMAND "${DUMP}" info OUTPUT_VARIABLE info RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "wray_dump info failed")
endif()
if(info MATCHES "\"fma\": true")
    set(class fma)
else()
    set(class nofma)
endif()
execute_process(COMMAND "${DUMP}" digest OUTPUT_VARIABLE got RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "wray_dump digest failed")
endif()
file(READ "${GOLDEN}/${class}.txt" want)
if(NOT got STREQUAL want)
    message(FATAL_ERROR "digest differs from tests/golden/${class}.txt:\n${got}")
endif()
